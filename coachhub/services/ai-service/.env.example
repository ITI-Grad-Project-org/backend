# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored; this template is safe to commit.

# MongoDB Atlas connection string (Atlas required for $vectorSearch).
SPRING_DATA_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?appName=<app>

# Google Gemini API key (chat + embeddings).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# RabbitMQ credentials.
RABBITMQ_USER=coachhub
RABBITMQ_PASSWORD=secret
