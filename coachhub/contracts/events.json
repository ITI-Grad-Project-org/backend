{
  "_path": "contracts/events.json",
  "_comment": "CoachHub event contract. messageType doubles as the RabbitMQ routing key on the 'coachhub.events' topic exchange. Every message is the envelope below with a typed 'payload'.",
  "exchange": {
    "name": "coachhub.events",
    "type": "topic"
  },
  "envelope": {
    "tenantId": "string (UUID)",
    "correlationId": "string (UUID)",
    "messageType": "string (== routing key)",
    "timestamp": "ISO-8601",
    "schemaVersion": "string (semver)",
    "payload": "object (see events[].payload)"
  },
  "events": [
    {
      "name": "client.invited",
      "routingKey": "client.invited",
      "consumers": [
        "notification-service"
      ],
      "payload": {
        "inviteId": "string (UUID)",
        "coachId": "string (UUID)",
        "coachName": "string",
        "clientEmail": "string (email)",
        "clientName": "string | null",
        "inviteToken": "string",
        "acceptUrl": "string (URL)",
        "expiresAt": "ISO-8601"
      }
    },
    {
      "name": "plan.assigned",
      "routingKey": "plan.assigned",
      "consumers": [
        "notification-service",
        "analytics-service"
      ],
      "payload": {
        "planId": "string (UUID)",
        "planTitle": "string",
        "coachId": "string (UUID)",
        "coachName": "string",
        "clientId": "string (UUID)",
        "clientEmail": "string (email)",
        "clientName": "string",
        "startsAt": "ISO-8601"
      }
    },
    {
      "name": "checkin.due",
      "routingKey": "checkin.due",
      "consumers": [
        "notification-service"
      ],
      "payload": {
        "checkinId": "string (UUID)",
        "clientId": "string (UUID)",
        "clientEmail": "string (email)",
        "clientName": "string",
        "coachName": "string",
        "dueAt": "ISO-8601"
      }
    },
    {
      "name": "checkin.submitted",
      "routingKey": "checkin.submitted",
      "consumers": [
        "analytics-service",
        "notification-service"
      ],
      "payload": {
        "checkinId": "string (UUID)",
        "clientId": "string (UUID)",
        "coachId": "string (UUID)",
        "submittedAt": "ISO-8601",
        "metrics": "object (free-form key/number)"
      }
    },
    {
      "name": "workout.logged",
      "routingKey": "workout.logged",
      "consumers": [
        "analytics-service"
      ],
      "payload": {
        "workoutId": "string (UUID)",
        "clientId": "string (UUID)",
        "loggedAt": "ISO-8601",
        "exerciseCount": "number",
        "durationMinutes": "number"
      }
    },
    {
      "name": "message.sent",
      "routingKey": "message.sent",
      "consumers": [
        "notification-service"
      ],
      "payload": {
        "messageId": "string (UUID)",
        "threadId": "string (UUID)",
        "fromUserId": "string (UUID)",
        "fromName": "string",
        "toUserId": "string (UUID)",
        "toEmail": "string (email)",
        "preview": "string",
        "sentAt": "ISO-8601"
      }
    },
    {
      "name": "ai.requested",
      "routingKey": "ai.requested",
      "consumers": [
        "ai-service"
      ],
      "payload": {
        "requestId": "string (UUID)",
        "clientId": "string (UUID) | null — set when a client asks, or the client a coach asks about",
        "coachId": "string (UUID) | null — set when a coach asks",
        "coachEmail": "string (email) | null — set when a coach asks",
        "kind": "string (e.g. plan_suggestion | form_review)",
        "prompt": "string"
      }
    },
    {
      "name": "ai.completed",
      "routingKey": "ai.completed",
      "consumers": [
        "analytics-service",
        "notification-service"
      ],
      "payload": {
        "requestId": "string (UUID)",
        "clientId": "string (UUID) | null — set when a client asks, or the client a coach asks about",
        "coachId": "string (UUID) | null — set when a coach asks",
        "coachEmail": "string (email) | null — set when a coach asks",
        "status": "string (succeeded | failed)",
        "summary": "string"
      }
    },
    {
      "name": "ai.plan.requested",
      "routingKey": "ai.plan.requested",
      "consumers": [
        "ai-service"
      ],
      "_comment": "Full-program generation. Carries the client's context AND the tenant's exercise/meal/food library, because the model selects ids from that library — planned_exercises.exercise_id and planned_meal_foods.source_food_id are NOT NULL foreign keys, so an invented name cannot be saved.",
      "payload": {
        "requestId": "string (UUID) — correlationId of this exchange",
        "suggestionId": "string (UUID) — the ai_plan_suggestions row to fill in",
        "membershipId": "string (UUID)",
        "coachId": "string (UUID)",
        "kind": "string (training | nutrition)",
        "context": "object — client profile, intake, recent measurements, constraints, library descriptor, coachNotes",
        "candidates": "object — { exercises[], meals[], foods[] }; only the lists the kind needs are populated"
      }
    },
    {
      "name": "ai.plan.completed",
      "routingKey": "ai.plan.completed",
      "consumers": [
        "core-api"
      ],
      "_comment": "The proposal travels back on this event and core-api stores it: accepting has to build the program tree in Postgres transactionally, which only core-api can do.",
      "payload": {
        "requestId": "string (UUID)",
        "suggestionId": "string (UUID)",
        "membershipId": "string (UUID)",
        "coachId": "string (UUID)",
        "kind": "string (training | nutrition)",
        "status": "string (succeeded | failed)",
        "plan": "object | null — the proposal; null when status is failed",
        "warnings": "array of { code, severity (error | warning), path, message }",
        "error": "string | null — why there is no plan",
        "modelMeta": "object | null — { model, finishReason, promptTokens, outputTokens, totalTokens, latencyMs }"
      }
    }
  ]
}
