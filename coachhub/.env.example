# Copy to .env and fill in. NEVER commit .env.

# ── Registry / images ────────────────────────────────────────────────────────
# Azure Container Registry login server; CI sets IMAGE_TAG to the git SHA.
REGISTRY=coachhub.azurecr.io
IMAGE_TAG=dev

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
CORE_DB_PASSWORD=change-me-core
ANALYTICS_DB_PASSWORD=change-me-analytics

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=coachhub
RABBITMQ_PASSWORD=change-me-rabbit

# ── core-api ─────────────────────────────────────────────────────────────────
# true = TypeORM auto-syncs schema (dev only!). Production always false + migrations.
DB_SYNCHRONIZE=true
JWT_ACCESS_SECRET=change-me-32-bytes-minimum
JWT_REFRESH_SECRET=change-me-32-bytes-minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
GOOGLE_OAUTH_CLIENT_ID=placeholder
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
AWS_REGION=us-east-1
AWS_S3_BUCKET=placeholder
AWS_S3_ACL=public-read

# ── AI (shared by core-api and ai-service) ───────────────────────────────────
GEMINI_API_KEY=change-me
AI_REQUEST_TIMEOUT_MS=30000

# ── ai-service ───────────────────────────────────────────────────────────────
# Managed MongoDB Atlas (vector search needs Atlas — community Mongo won't work).
MONGODB_ATLAS_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/coachhub-rag?retryWrites=true
RAG_SEED_ON_STARTUP=true

# ── notification-service ─────────────────────────────────────────────────────
# Gmail SMTP (current setup). MAIL_PASSWORD must be a 16-char *App Password*
# (Google Account → Security → 2-Step Verification → App passwords) — a normal
# account password is rejected. Gmail only sends as the authenticated account,
# so MAIL_FROM must equal MAIL_USERNAME (or a verified alias).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=you@gmail.com
# MAIL_PASSWORD is also read by deploy/k8s/create-secrets.sh.
#
# Offline capture instead (no real sending) — MailHog UI on :8025:
#   MAIL_HOST=mailhog  MAIL_PORT=1025  MAIL_SMTP_AUTH=false  MAIL_SMTP_STARTTLS=false
# Higher-volume production: Resend/SES →
#   MAIL_HOST=smtp.resend.com  MAIL_USERNAME=resend  MAIL_PASSWORD=<api key>

# ── Paymob (payments) ────────────────────────────────────────────────────────
# Dashboard → Settings → Account Info for the keys, and Developers →
# Payment Integrations for the integration id. Test keys are prefixed
# egy_pk_test_ / egy_sk_test_; live ones drop the `test`.
#
# The four keys below are SECRETS and are read by deploy/k8s/create-secrets.sh.
PAYMOB_API_KEY=changeme
PAYMOB_PUBLIC_KEY=egy_pk_test_changeme
PAYMOB_SECRET_KEY=egy_sk_test_changeme
# Used to verify the HMAC on Paymob's webhook callbacks. Without it any caller
# could POST a forged "payment succeeded" to the webhook endpoint.
PAYMOB_HMAC_SECRET=changeme
#
# The rest are NOT secrets — in production they live in the app-config
# ConfigMap (deploy/k8s/10-config/app-config.yaml), not in app-secrets.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_INTEGRATION_ID_CARD=0000000
# Paymob must reach this from the internet. Locally, use an ngrok/cloudflared
# tunnel — a localhost URL will simply never be called back.
PAYMOB_NOTIFICATION_URL=https://your-api-host/billing/paymob/webhook
PAYMOB_REDIRECTION_URL=https://your-frontend-host/billing/result
PAYMOB_REQUEST_TIMEOUT_MS=15000
